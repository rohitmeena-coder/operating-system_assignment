--- xv6-pristine/trap.c
+++ xv6-rohit-meena-assignment9/trap.c
@@
   switch(tf->trapno){
+  case T_PGFLT: {
+    // Rohit Meena Assignment 9 Q2: satisfy only faults inside the reserved user heap.
+    uint va = rcr2(), pa;
+    pte_t *pte;
+    if(va >= myproc()->sz || va < PGROUNDUP(tf->esp - 2 * PGSIZE))
+      goto badpgflt;
+    va = PGROUNDDOWN(va);
+    pte = walkpgdir(myproc()->pgdir, (char*)va, 0);
+    if(pte && (*pte & PTE_P)) goto badpgflt;
+    if((pa = (uint)kalloc()) == 0) goto badpgflt;
+    memset(P2V(pa), 0, PGSIZE);
+    if(mappages(myproc()->pgdir, (char*)va, PGSIZE, pa, PTE_W|PTE_U) < 0){
+      kfree(P2V(pa));
+      goto badpgflt;
+    }
+    myproc()->pagefaults++;
+    break;
+badpgflt:
+    cprintf("pid %d: invalid page fault va 0x%x\n", myproc()->pid, rcr2());
+    myproc()->killed = 1;
+    break;
+  }

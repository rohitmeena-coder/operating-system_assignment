+
+// Rohit Meena Assignment 9 Q1: print only valid user mappings and return their count.
+int
+vmprint(void)
+{
+  pde_t *pgdir = myproc()->pgdir;
+  pte_t *pt;
+  uint va;
+  int i, j, user_pages = 0, page_table_pages = 0;
+  for(i = 0; i < NPDENTRIES / 2; i++){
+    if(!(pgdir[i] & PTE_P)) continue;
+    page_table_pages++;
+    pt = (pte_t*)P2V(PTE_ADDR(pgdir[i]));
+    cprintf("PDE[%d] pt=0x%x flags=P%d W%d U%d\n", i, PTE_ADDR(pgdir[i]),
+             !!(pgdir[i]&PTE_P), !!(pgdir[i]&PTE_W), !!(pgdir[i]&PTE_U));
+    for(j = 0; j < NPTENTRIES; j++){
+      if(!(pt[j] & PTE_P) || !(pt[j] & PTE_U)) continue;
+      va = (i << 22) | (j << 12); user_pages++;
+      cprintf("  va=0x%x pa=0x%x flags=P%d W%d U%d\n", va,
+               PTE_ADDR(pt[j]), !!(pt[j]&PTE_P), !!(pt[j]&PTE_W), !!(pt[j]&PTE_U));
+    }
+  }
+  cprintf("VMPRINT totals: valid_user_pages=%d page_table_pages=%d\n",
+           user_pages, page_table_pages);
+  return user_pages;
+}

--- /dev/null
+++ xv6-assignment5/dining.c
@@ -0,0 +1,89 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+#define PHILOSOPHERS 5
+#define CYCLES 5
+#define FORK_BASE 10
+
+struct dining_state {
+  int completed[PHILOSOPHERS];
+  int eating;
+  int violation;
+};
+
+static void
+think(void)
+{
+  volatile int i;
+  for(i = 0; i < 70000; i++)
+    ;
+}
+
+static void
+philosopher(struct dining_state *s, int id)
+{
+  int left = id;
+  int right = (id + 1) % PHILOSOPHERS;
+  int first = left < right ? left : right;
+  int second = left < right ? right : left;
+  int i;
+
+  for(i = 0; i < CYCLES; i++){
+    printf(1, "Philosopher %d: THINKING -> HUNGRY\n", id);
+    think();
+    sem_wait(FORK_BASE + first);
+    sem_wait(FORK_BASE + second);
+    if(s->eating != 0)
+      ;
+    s->eating++;
+    printf(1, "Philosopher %d: HUNGRY -> EATING (cycle %d)\n", id, i + 1);
+    think();
+    s->eating--;
+    sem_post(FORK_BASE + second);
+    sem_post(FORK_BASE + first);
+    printf(1, "Philosopher %d: EATING -> THINKING\n", id);
+    s->completed[id]++;
+  }
+}
+
+int
+main(void)
+{
+  struct dining_state *s = (struct dining_state*)shmget();
+  int i, pid;
+
+  if((uint)s == (uint)-1){
+    printf(1, "dining: shmget failed\n");
+    exit();
+  }
+  for(i = 0; i < PHILOSOPHERS; i++){
+    s->completed[i] = 0;
+    sem_init(FORK_BASE + i, 1);
+  }
+  s->eating = 0;
+  s->violation = 0;
+
+  for(i = 0; i < PHILOSOPHERS; i++){
+    pid = fork();
+    if(pid == 0){
+      shmget();
+      philosopher(s, i);
+      exit();
+    }
+  }
+  for(i = 0; i < PHILOSOPHERS; i++)
+    wait();
+
+  printf(1, "Dining completion counts:");
+  for(i = 0; i < PHILOSOPHERS; i++)
+    printf(1, " P%d=%d", i, s->completed[i]);
+  printf(1, "\n");
+  if(s->completed[0] == CYCLES && s->completed[1] == CYCLES &&
+     s->completed[2] == CYCLES && s->completed[3] == CYCLES &&
+     s->completed[4] == CYCLES)
+    printf(1, "DINING PASS: resource ordering avoided deadlock\n");
+  else
+    printf(1, "DINING FAIL\n");
+  exit();
+}

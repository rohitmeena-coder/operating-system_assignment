+
+// Install the kernel-owned synchronization page at a fixed user address.
+// The check makes repeated shmget() calls harmless for one process.
+int
+map_shared_page(pde_t *pgdir, uint pa)
+{
+  pte_t *pte = walkpgdir(pgdir, (void*)SHMBASE, 1);
+  if(pte == 0)
+    return -1;
+  if(*pte & PTE_P)
+    return 0;
+  *pte = pa | PTE_W | PTE_U | PTE_P;
   return 0;
 }
 

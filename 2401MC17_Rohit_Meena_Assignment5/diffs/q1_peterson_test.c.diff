--- /dev/null
+++ xv6-assignment5/peterson.c
@@ -0,0 +1,83 @@
+#include "types.h"
+#include "stat.h"
+#include "user.h"
+
+struct shared_state {
+  volatile int flag[2];
+  volatile int turn;
+  volatile int counter;
+  volatile int in_cs;
+  volatile int violation;
+};
+
+static void
+remainder_work(void)
+{
+  volatile int i;
+  for(i = 0; i < 200000; i++)
+    ;
+}
+
+static void
+run_process(struct shared_state *s, int id)
+{
+  int other = 1 - id;
+  int i;
+
+  for(i = 0; i < 10; i++){
+    s->flag[id] = 1;
+    s->turn = other;
+    while(s->flag[other] && s->turn == other)
+      ;
+
+    if(s->in_cs != 0)
+      s->violation = 1;
+    s->in_cs = id + 1;
+    s->counter++;
+    printf(1, "Process %d in CS, counter = %d\n", id, s->counter);
+    for(volatile int delay = 0; delay < 50000; delay++)
+      ;
+    s->in_cs = 0;
+    s->flag[id] = 0;
+    remainder_work();
+  }
+}
+
+int
+main(void)
+{
+  struct shared_state *s;
+  int pid;
+
+  s = (struct shared_state*)shmget();
+  if((uint)s == (uint)-1){
+    printf(1, "peterson: shmget failed\n");
+    exit();
+  }
+  s->flag[0] = s->flag[1] = 0;
+  s->turn = 0;
+  s->counter = 0;
+  s->in_cs = 0;
+  s->violation = 0;
+
+  pid = fork();
+  if(pid < 0){
+    printf(1, "peterson: fork failed\n");
+    exit();
+  }
+  if(pid == 0){
+    shmget();
+    run_process(s, 1);
+    exit();
+  }
+  run_process(s, 0);
+  wait();
+
+  printf(1, "Peterson final counter = %d (expected 20)\n", s->counter);
+  printf(1, "Mutual exclusion violations = %d\n", s->violation);
+  if(s->counter == 20 && s->violation == 0)
+    printf(1, "PETERSON PASS\n");
+  else
+    printf(1, "PETERSON FAIL\n");
+  exit();
+}
